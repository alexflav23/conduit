# Local dev env template. Copy to .env (gitignored) and fill in, OR — preferred — let direnv pull these from
# SSM (see .envrc; run `direnv allow` with a live AWS session). Never commit real secrets.
#
#   cp .env.example .env   # then paste values, or rely on direnv/SSM instead

# Public OAuth client id (not a secret) — the API verifier + the desk sign-in. Also exposed to Vite as
# VITE_GOOGLE_CLIENT_ID by .envrc.
GOOGLE_OAUTH_CLIENT_ID=

# Google OAuth client SECRET — needed ONLY for Keycloak to broker Google (the code flow). Used by
# keycloak/configure-google-idp.sh; never committed. In SSM as a SecureString at
# /<env>/conduit/GOOGLE_OAUTH_CLIENT_SECRET.
GOOGLE_OAUTH_CLIENT_SECRET=
