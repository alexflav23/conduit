#!/bin/env zsh
# Local dev environment, mirroring athena/.envrc. Pulls config from SSM under /<env>/conduit/ and exports it
# into the shell so `sbt api/run`, the consumer, and `yarn start`/`yarn build` (conduit-desk) all see the same
# values the deployed hosts get from mk-env. Requires direnv (`direnv allow`) + a live AWS session (aws-vault).
#
# Convention: conduit SSM params are FLAT (e.g. /staging/conduit/GOOGLE_OAUTH_CLIENT_ID), and the leaf name IS
# the env var name — identical to what mk-env.sh exports on the instances. So adding a var here is one line,
# and it stays in lockstep with the deployed surface.
set -euo pipefail
env="staging"

export AWS_DEFAULT_REGION=eu-west-1

get_parameter() {
  aws ssm get-parameter --name /"${env}"/conduit/"$1" --query Parameter.Value --output text
}

get_secure_parameter() {
  aws ssm get-parameter --name /"${env}"/conduit/"$1" --with-decryption --query Parameter.Value --output text
}

# Cached so direnv reloads don't hit SSM every time. Delete .envrc_cached to refresh.
if [[ ! -f .envrc_cached ]]; then

  google_oauth_client_id="$(get_parameter GOOGLE_OAUTH_CLIENT_ID)"

  # Add more as their /staging/conduit/<NAME> params land, following the same flat-name pattern, e.g.:
  #   xero_client_id="$(get_secure_parameter XERO_CLIENT_ID)"
  #   stripe_webhook_secret="$(get_secure_parameter STRIPE_WEBHOOK_SECRET)"

  cat > .envrc_cached <<EOF
export HYPERVOLT_ENV="local"

# One public OAuth client id, two consumers: the API verifier (GOOGLE_OAUTH_CLIENT_ID) and the desk sign-in
# button (VITE_GOOGLE_CLIENT_ID, inlined by Vite at build time).
export GOOGLE_OAUTH_CLIENT_ID="$google_oauth_client_id"
export VITE_GOOGLE_CLIENT_ID="$google_oauth_client_id"

#   export XERO_CLIENT_ID="$xero_client_id"
#   export STRIPE_WEBHOOK_SECRET="$stripe_webhook_secret"
EOF

fi

source_env .envrc_cached
source_env_if_exists .envrc.private
